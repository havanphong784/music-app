{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "index.ts",
    "api/**/*.ts",
    "config/**/*.ts",
    "tests/**/*.ts",
    "prisma.config.ts"
  ]
}
